# ImpactChain AI — Environment Variables Template
# Copy this file to .env and fill in your API keys.

# MANDATORY — Groq API key for relationship extraction (Phase 1 Step 1.3)
GROQ_API_KEY=your_groq_api_key_here

# RECOMMENDED — NewsAPI key for headline ingestion (Phase 1 Step 1.1)
# Without this, only RSS feeds will be used.
NEWSAPI_KEY=your_newsapi_key_here

# OPTIONAL — Database path (relative to backend/ or absolute)
DATABASE_PATH=data/master.db

# OPTIONAL — Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
